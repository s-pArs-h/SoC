# kmeans_accel (with kmeans_core and the streamer FIFO), bus fully free.
#   prove  k-induction: the streamer never overfills its FIFO or reads past
#          the run; the FIFO and kmeans_core invariants hold
#   bmc    bounded (30 cycles): every run starts with the streamer drained
#   cover  a new run starting after a finished run of 3 or more points
[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 8
bmc:   mode bmc
bmc:   depth 30
cover: mode cover
cover: depth 30

[engines]
smtbmc yices

[script]
prove: read -formal distance_calc.sv min_tree.sv kmeans_core.sv sync_fifo.sv kmeans_accel.sv accel_formal.sv
~prove: read -formal -D KMEANS_ACCEL_BMC distance_calc.sv min_tree.sv kmeans_core.sv sync_fifo.sv kmeans_accel.sv accel_formal.sv
prep -flatten -top accel_formal
memory_map
opt -fast

[files]
../ip/kmeans/distance_calc.sv
../ip/kmeans/min_tree.sv
../ip/kmeans/kmeans_core.sv
../rtl/sync_fifo.sv
../rtl/kmeans_accel.sv
accel_formal.sv
